:name: BBC micro:bit V2 - ble_broadcaster
:description: Sheet 4 BLE advertising/scanning with micro:bit-targeted ELFs

using sysbus
$broadcaster_bin?=$ORIGIN/../ble_broadcaster/build-renode/zephyr/zephyr.elf

emulation CreateBLEMedium "wireless"
emulation SetGlobalQuantum "0.00001"

mach create "broadcaster"
machine LoadPlatformDescription $ORIGIN/microbit_ble.repl
connector Connect radio wireless
wireless SetPosition radio 0 0 0
emulation CreateServerSocketTerminal 60001 "broadcaster_uart" false
connector Connect uart0 broadcaster_uart
showAnalyzer uart0
sysbus LoadELF $broadcaster_bin
cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`

# Optional Wireshark capture: uncomment if Wireshark is installed.
# emulation LogBLETraffic

start
